# Copy these variable names into your deployment/local environment and fill in real values.
# Never commit your actual .env file or real credentials.

PORT=3000
FRONTEND_URL=https://the-healing-star.vercel.app
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret

CALENDLY_ACCESS_TOKEN=replace-with-calendly-token
CALENDLY_WEBHOOK_URL=https://YOUR-BACKEND-DOMAIN/calendly/webhook
CALENDLY_WEBHOOK_SIGNING_KEY=copy-the-signing-key-from-admin-calendly-settings

# Optional: service booking confirmation/cancellation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=
